rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is staff or admin
    function isStaff() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Shipments collection
    match /shipments/{shipmentId} {
      // Anyone can read shipments (for tracking)
      allow read: if true;
      
      // Only authenticated staff can create and update shipments
      allow create: if isStaff();
      allow update: if isStaff();
      
      // Only admin can delete shipments
      allow delete: if isAdmin();
    }

    // Routes collection
    match /routes/{routeId} {
      // Anyone can read routes (for shipment creation)
      allow read: if true;
      
      // Only authenticated staff can create and update routes
      allow create: if isStaff();
      allow update: if isStaff();
      
      // Only admin can delete routes
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Only admin can create, update, and delete users
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
      
      // Admin can list all users
      allow list: if isAdmin();
    }
  }
}
